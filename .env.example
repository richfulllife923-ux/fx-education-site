# Cloudflare Pages Functions server-only bindings. Never use NEXT_PUBLIC_ prefixes.
# FREE is the default; Japan uses EDINET. US live access is disabled until reviewed restoration.
STOCK_DATA_MODE=FREE
# Both flags must be true before the Pages API can route US requests. Default is fail-closed.
SEC_LIVE_ENABLED=false
SEC_PUBLIC_RELEASE_APPROVED=false
# Public administrator contact for SEC declared User-Agent. Read on server only.
SEC_CONTACT_EMAIL=
# EDINET subscription key: provision as a server secret; never paste it in chat or commit it.
EDINET_API_KEY=
# Optional EDINET_FILING_INDEX KV binding holds JSON at key "edinet-filings".
# Without the binding, the checked local server/stock-analysis/edinet-filings.json is used.
# Optional commercial mode, preserved for owner-approved contracts only.
EODHD_API_KEY=
EODHD_PUBLIC_DISPLAY_APPROVED=false
EODHD_CACHE_APPROVED=false
# Optional administrator-selected research symbols, max 4. Empty by default.
TUTTO_WATCHLIST_SYMBOLS=
